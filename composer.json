{
    "name": "dmstr/flowable-bundle",
    "description": "Flowable BPMN engine pass-through resources, HTTP client and CLI for API Platform / Symfony.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "symfony",
        "api-platform",
        "flowable",
        "bpmn",
        "workflow",
        "process-engine"
    ],
    "authors": [
        {
            "name": "diemeisterei GmbH",
            "homepage": "https://diemeisterei.de"
        }
    ],
    "require": {
        "php": ">=8.5",
        "api-platform/core": "^4.3.18",
        "dmstr/api-configuration-bundle": "^0.6",
        "dmstr/api-platform-utils-bundle": "^0.6.0",
        "dmstr/openapi-json-schema-bundle": "^0.3.0 || ^0.4.0",
        "doctrine/orm": "^3.0",
        "opis/json-schema": "^2.0",
        "psr/log": "^3.0",
        "symfony/config": "^7.0",
        "symfony/console": "^7.0",
        "symfony/dependency-injection": "^7.0",
        "symfony/expression-language": "^7.0",
        "symfony/framework-bundle": "^7.0",
        "symfony/http-client": "^7.0",
        "symfony/http-foundation": "^7.0",
        "symfony/http-kernel": "^7.0",
        "symfony/object-mapper": "^7.0",
        "symfony/security-bundle": "^7.0",
        "symfony/serializer": "^7.0",
        "symfony/yaml": "^7.0"
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "ext-zip": "*",
        "doctrine/doctrine-bundle": "^2.8",
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "mcp/sdk": "^0.8.1",
        "nyholm/psr7": "^1.8",
        "phpunit/phpunit": "^12.0",
        "symfony/browser-kit": "^7.0",
        "symfony/mcp-bundle": "^0.14"
    },
    "suggest": {
        "mcp/sdk": "Required by symfony/mcp-bundle; provides the MCP server runtime that API Platform's McpTool handler runs on.",
        "symfony/mcp-bundle": "Serves the bundle's McpTool operations as MCP tools (enable them via dmstr_flowable.mcp.read / mcp.write / mcp.deploy)."
    },
    "autoload": {
        "psr-4": {
            "Dmstr\\Flowable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dmstr\\Flowable\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
