{
    "flowable_complete_task": {
        "description": "Input for completing a user task.",
        "type": "object",
        "properties": {
            "id": {
                "type": "string",
                "description": "Id of the open user task to complete."
            },
            "variables": {
                "description": "Process variables: shorthand map {name: value} or explicit list [{name,value,type}].",
                "oneOf": [
                    {
                        "type": "object"
                    },
                    {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": [
                                "name"
                            ],
                            "properties": {
                                "name": {
                                    "type": "string"
                                },
                                "value": {},
                                "type": {
                                    "type": "string",
                                    "enum": [
                                        "string",
                                        "integer",
                                        "short",
                                        "long",
                                        "double",
                                        "boolean",
                                        "date",
                                        "json"
                                    ]
                                }
                            },
                            "additionalProperties": false
                        }
                    }
                ]
            },
            "apiConfiguration": {
                "description": "Optional Flowable ApiConfiguration selector: the first 8 characters of its UUID or the full UUID, lowercase.",
                "oneOf": [
                    {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})?$"
                    },
                    {
                        "type": "object",
                        "required": [
                            "uuid"
                        ],
                        "properties": {
                            "uuid": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})?$"
                            }
                        },
                        "additionalProperties": false
                    }
                ]
            }
        },
        "additionalProperties": false,
        "required": [
            "id"
        ]
    },
    "flowable_deploy_bundle": {
        "description": "Arguments of the MCP tool flowable_deploy_bundle: several files deployed as one process deployment (packed into a .bar archive).",
        "type": "object",
        "required": [
            "files",
            "deploymentName"
        ],
        "properties": {
            "files": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "description": "The files of the deployment, e.g. one .bpmn20.xml plus the <formKey>.schema.json form schemas its user tasks reference. At most 20 files and 4 MiB in total after decoding.",
                "items": {
                    "type": "object",
                    "required": [
                        "name",
                        "content"
                    ],
                    "properties": {
                        "name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 255,
                            "description": "Plain file name (no path) ending in .bpmn, .bpmn20.xml, .xml, .form or .json, in any letter case; .dmn.xml and .cmmn.xml are refused."
                        },
                        "content": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 1400000,
                            "description": "File content as text, or base64 with contentEncoding \"base64\"; at most 1 MiB after decoding."
                        },
                        "contentEncoding": {
                            "type": "string",
                            "enum": [
                                "base64"
                            ],
                            "description": "Set to \"base64\" when content is base64-encoded."
                        }
                    },
                    "additionalProperties": false
                }
            },
            "deploymentName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "description": "Deployment name, shown in the deployment list."
            },
            "deploymentSource": {
                "type": "string",
                "maxLength": 255,
                "description": "Optional free-text source marker stored on the deployment."
            },
            "category": {
                "type": "string",
                "maxLength": 255,
                "description": "Optional deployment category."
            },
            "tenantId": {
                "type": "string",
                "maxLength": 255,
                "description": "Optional tenant id."
            },
            "apiConfiguration": {
                "description": "Optional Flowable ApiConfiguration selector: the first 8 characters of its UUID or the full UUID, lowercase. Omit to use the default engine connection.",
                "oneOf": [
                    {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})?$"
                    },
                    {
                        "type": "object",
                        "required": [
                            "uuid"
                        ],
                        "properties": {
                            "uuid": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})?$"
                            }
                        },
                        "additionalProperties": false
                    }
                ]
            }
        },
        "additionalProperties": false
    },
    "flowable_dmn_deploy": {
        "description": "Arguments of the MCP tool flowable_dmn_deploy: one decision resource passed inline instead of the multipart upload of POST /flowable/dmn_deployments/upload.",
        "type": "object",
        "required": [
            "name",
            "content"
        ],
        "properties": {
            "name": {
                "type": "string",
                "maxLength": 255,
                "pattern": "\\.[dD][mM][nN]$",
                "description": "File name including the extension .dmn (archives .bar/.zip only through the HTTP upload)."
            },
            "content": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1400000,
                "description": "File content: the DMN XML as text, or base64 with contentEncoding \"base64\"; at most 1 MiB after decoding."
            },
            "contentEncoding": {
                "type": "string",
                "enum": [
                    "base64"
                ],
                "description": "Set to \"base64\" when content is base64-encoded."
            },
            "deploymentName": {
                "type": "string",
                "maxLength": 255,
                "description": "Deployment name (defaults to the file name)."
            },
            "category": {
                "type": "string",
                "maxLength": 255,
                "description": "Optional deployment category."
            },
            "tenantId": {
                "type": "string",
                "maxLength": 255,
                "description": "Optional tenant id."
            },
            "apiConfiguration": {
                "description": "Optional Flowable ApiConfiguration selector: the first 8 characters of its UUID or the full UUID, lowercase. Omit to use the default engine connection.",
                "oneOf": [
                    {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})?$"
                    },
                    {
                        "type": "object",
                        "required": [
                            "uuid"
                        ],
                        "properties": {
                            "uuid": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})?$"
                            }
                        },
                        "additionalProperties": false
                    }
                ]
            }
        },
        "additionalProperties": false
    },
    "flowable_dmn_evaluate": {
        "description": "Input for evaluating a DMN decision by key.",
        "type": "object",
        "required": [
            "decisionKey"
        ],
        "properties": {
            "decisionKey": {
                "type": "string",
                "title": "Decision key",
                "description": "Key of the decision to evaluate (latest deployed version is used)."
            },
            "singleResult": {
                "type": "boolean",
                "default": false,
                "title": "Single result",
                "description": "Use the engine's single-result evaluation (one output row) instead of the full list of matching rows."
            },
            "inputVariables": {
                "description": "Decision input variables: shorthand map {name: value} or explicit list [{name,type,value}].",
                "oneOf": [
                    {
                        "type": "object"
                    },
                    {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": [
                                "name"
                            ],
                            "properties": {
                                "name": {
                                    "type": "string"
                                },
                                "value": {},
                                "type": {
                                    "type": "string",
                                    "enum": [
                                        "string",
                                        "integer",
                                        "short",
                                        "long",
                                        "double",
                                        "boolean",
                                        "date",
                                        "json"
                                    ]
                                }
                            },
                            "additionalProperties": false
                        }
                    }
                ]
            },
            "apiConfiguration": {
                "description": "Optional Flowable ApiConfiguration selector: the first 8 characters of its UUID or the full UUID, lowercase.",
                "oneOf": [
                    {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})?$"
                    },
                    {
                        "type": "object",
                        "required": [
                            "uuid"
                        ],
                        "properties": {
                            "uuid": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})?$"
                            }
                        },
                        "additionalProperties": false
                    }
                ]
            }
        },
        "additionalProperties": false
    },
    "flowable_events_send": {
        "description": "Input for sending an event instance to an inbound channel of the event registry. Both an event definition reference and a channel definition reference are required — the engine rejects a body missing either.",
        "type": "object",
        "properties": {
            "eventDefinitionKey": {
                "type": "string",
                "title": "Event definition key",
                "description": "Key of the event definition to send (latest deployed version is used)."
            },
            "eventDefinitionId": {
                "type": "string",
                "title": "Event definition id",
                "description": "Specific event definition id, taking precedence over the key."
            },
            "channelDefinitionKey": {
                "type": "string",
                "title": "Channel definition key",
                "description": "Key of the inbound channel definition that receives the event."
            },
            "channelDefinitionId": {
                "type": "string",
                "title": "Channel definition id",
                "description": "Specific inbound channel definition id, taking precedence over the key."
            },
            "tenantId": {
                "type": "string",
                "title": "Tenant id",
                "description": "Optional tenant the event definition and channel are resolved in."
            },
            "eventPayload": {
                "type": "object",
                "title": "Event payload",
                "description": "The event body as a JSON object, matching the event definition's payload contract. Must be an object — the engine rejects an array."
            },
            "apiConfiguration": {
                "description": "Optional Flowable ApiConfiguration selector: the first 8 characters of its UUID or the full UUID, lowercase.",
                "oneOf": [
                    {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})?$"
                    },
                    {
                        "type": "object",
                        "required": [
                            "uuid"
                        ],
                        "properties": {
                            "uuid": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})?$"
                            }
                        },
                        "additionalProperties": false
                    }
                ]
            }
        },
        "additionalProperties": false
    },
