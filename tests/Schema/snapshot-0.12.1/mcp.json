    "flowable_list_process_definitions": {
        "description": "Arguments of the MCP tool flowable_list_process_definitions (filters of GET /flowable/process_definitions).",
        "type": "object",
        "properties": {
            "page": {
                "type": "integer",
                "minimum": 1,
                "default": 1,
                "description": "Page number, starting at 1."
            },
            "itemsPerPage": {
                "type": "integer",
                "minimum": 1,
                "maximum": 200,
                "default": 30,
                "description": "Page size (1 to 200)."
            },
            "sort": {
                "type": "string",
                "description": "Flowable sort field (default: engine order)."
            },
            "order": {
                "type": "string",
                "enum": [
                    "asc",
                    "desc"
                ],
                "default": "desc",
                "description": "Sort direction."
            },
            "latest": {
                "type": "boolean",
                "description": "true keeps only the latest version per key (use it to find startable definitions)."
            },
            "key": {
                "type": "string",
                "description": "Filter by process definition key."
            },
            "category": {
                "type": "string",
                "description": "Filter by category."
            },
            "deployment": {
                "type": "string",
                "description": "Filter by deployment (id or IRI)."
            },
            "apiConfiguration": {
                "description": "Optional Flowable ApiConfiguration selector: the first 8 characters of its UUID or the full UUID, lowercase. Omit to use the default engine connection.",
                "oneOf": [
                    {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})?$"
                    },
                    {
                        "type": "object",
                        "required": [
                            "uuid"
                        ],
                        "properties": {
                            "uuid": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})?$"
                            }
                        },
                        "additionalProperties": false
                    }
                ]
            }
        },
        "additionalProperties": false
    },
