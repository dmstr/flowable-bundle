{
  "$defs": {
    "uuidSelector": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})?$"
    },
    "apiConfiguration": {
      "description": "Optional Flowable ApiConfiguration selector: the first 8 characters of its UUID or the full UUID, lowercase.",
      "oneOf": [
        {
          "$ref": "#/$defs/uuidSelector"
        },
        {
          "type": "object",
          "required": [
            "uuid"
          ],
          "properties": {
            "uuid": {
              "$ref": "#/$defs/uuidSelector"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "apiConfigurationOrDefault": {
      "$ref": "#/$defs/apiConfiguration",
      "description": "Optional Flowable ApiConfiguration selector: the first 8 characters of its UUID or the full UUID, lowercase. Omit to use the default engine connection."
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Page number, starting at 1."
    },
    "itemsPerPage": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200,
      "default": 30,
      "description": "Page size (1 to 200)."
    },
    "sort": {
      "type": "string",
      "description": "Flowable sort field."
    },
    "order": {
      "type": "string",
      "enum": [
        "asc",
        "desc"
      ],
      "default": "desc",
      "description": "Sort direction."
    }
  }
}
