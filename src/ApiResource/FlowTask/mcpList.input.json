{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://za7.example.com/schemas/flowable-list-tasks-input.json",
  "title": "flowable_list_tasks input",
  "description": "Arguments of the MCP tool flowable_list_tasks (filters of GET /flowable/tasks).",
  "type": "object",
  "properties": {
    "page": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Page number, starting at 1."
    },
    "itemsPerPage": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200,
      "default": 30,
      "description": "Page size (1 to 200)."
    },
    "sort": {
      "type": "string",
      "description": "Flowable sort field (default: createTime, newest first)."
    },
    "order": {
      "type": "string",
      "enum": [
        "asc",
        "desc"
      ],
      "default": "desc",
      "description": "Sort direction."
    },
    "processInstanceId": {
      "type": "string",
      "description": "Filter by process instance id."
    },
    "processDefinition": {
      "type": "string",
      "description": "Filter by process definition (id or IRI)."
    },
    "assignee": {
      "type": "string",
      "description": "Filter by assignee (user id)."
    },
    "taskDefinitionKey": {
      "type": "string",
      "description": "Filter by task definition key (the BPMN userTask id)."
    },
    "apiConfiguration": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})?$",
      "description": "Optional Flowable ApiConfiguration selector (full or partial UUID). Omit to use the default engine connection."
    }
  },
  "additionalProperties": false
}
