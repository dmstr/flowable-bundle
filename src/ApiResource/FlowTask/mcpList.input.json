{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://za7.example.com/schemas/flowable-list-tasks-input.json",
  "title": "flowable_list_tasks input",
  "description": "Arguments of the MCP tool flowable_list_tasks (filters of GET /flowable/tasks).",
  "type": "object",
  "properties": {
    "page": {
      "$ref": "../../Schema/api-configuration.json#/$defs/page"
    },
    "itemsPerPage": {
      "$ref": "../../Schema/api-configuration.json#/$defs/itemsPerPage"
    },
    "sort": {
      "$ref": "../../Schema/api-configuration.json#/$defs/sort",
      "description": "Flowable sort field (default: createTime, newest first)."
    },
    "order": {
      "$ref": "../../Schema/api-configuration.json#/$defs/order"
    },
    "processInstanceId": {
      "type": "string",
      "description": "Filter by process instance id."
    },
    "processDefinition": {
      "type": "string",
      "description": "Filter by process definition (id or IRI)."
    },
    "assignee": {
      "type": "string",
      "description": "Filter by assignee (user id)."
    },
    "taskDefinitionKey": {
      "type": "string",
      "description": "Filter by task definition key (the BPMN userTask id)."
    },
    "apiConfiguration": {
      "$ref": "../../Schema/api-configuration.json#/$defs/apiConfigurationOrDefault"
    }
  },
  "additionalProperties": false
}
