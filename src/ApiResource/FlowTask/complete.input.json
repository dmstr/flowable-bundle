{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://za7.example.com/schemas/flow-task-complete-input.json",
  "title": "flow_task_complete input",
  "description": "Input for completing a user task.",
  "type": "object",
  "properties": {
    "variables": {
      "description": "Process variables: shorthand map {name: value} or explicit list [{name,value,type}].",
      "oneOf": [
        { "type": "object" },
        {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "value": {},
              "type": { "type": "string", "enum": ["string", "integer", "short", "long", "double", "boolean", "date", "json"] }
            },
            "additionalProperties": false
          }
        }
      ]
    },
    "apiConfiguration": {
      "$ref": "../../Schema/api-configuration.json#/$defs/apiConfiguration"
    }
  },
  "additionalProperties": false
}
