{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://za7.example.com/schemas/flowable-system-execute-timer-job-input.json",
  "title": "flowable_system_execute_timer_job input",
  "description": "Arguments of the MCP tool flowable_system_execute_timer_job besides the timer job id.",
  "type": "object",
  "properties": {
    "apiConfiguration": {
      "description": "Optional Flowable ApiConfiguration selector (full or partial UUID). Omit to use the default engine connection.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})?$"
        },
        {
          "type": "object",
          "required": [
            "uuid"
          ],
          "properties": {
            "uuid": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
